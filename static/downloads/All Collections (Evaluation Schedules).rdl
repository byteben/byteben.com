<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <Description>This report displays all the collections in the hierarchy.</Description>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_">
      <DataSourceReference>/ConfigMgr_PO1/{5C6358F2-4BB6-4a1b-A16E-8D96795D8602}</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>40ed2703-ce5c-4e87-ab3b-ecca1d611927</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet0">
      <Query>
        <DataSourceName>AutoGen__5C6358F2_4BB6_4a1b_A16E_8D96795D8602_</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@EvaluationType">
            <Value>=Parameters!EvaluationType.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT SiteID
      ,CollectionName
      ,Flags
      ,CollectionComment
      ,CollectionType,

Case
When Flags = 1 Then 'None' 
When Flags = 2 Then 'Periodic' 
When Flags = 4 Then 'Continuous' 
When Flags = 6 Then 'Both'
End As 'Evaluation',

Case
When CollectionType = 1 Then 'User' 
When CollectionType = 2 Then 'Device' 
End As 'CollectionType_1'


FROM dbo.v_Collections_G

Where Flags = @EvaluationType

Order By Flags Desc</CommandText>
      </Query>
      <Fields>
        <Field Name="SiteID">
          <DataField>SiteID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CollectionName">
          <DataField>CollectionName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Flags">
          <DataField>Flags</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CollectionComment">
          <DataField>CollectionComment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CollectionType">
          <DataField>CollectionType</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Evaluation">
          <DataField>Evaluation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CollectionType_1">
          <DataField>CollectionType_1</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
