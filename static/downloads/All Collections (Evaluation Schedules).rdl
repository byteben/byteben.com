  <ReportParameters>
    <ReportParameter Name="EvaluationType">
      <DataType>String</DataType>
      <Prompt>ReportParameter1</Prompt>
      <ValidValues>
        <ParameterValues>
          <ParameterValue>
            <Value>1</Value>
            <Label>None</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>4</Value>
            <Label>Incremental (Continuous)</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>2</Value>
            <Label>Full Schedule (Periodic)</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>6</Value>
            <Label>Both (Periodic and Continuous)</Label>
          </ParameterValue>
          <ParameterValue>
            <Value>*</Value>
            <Label>All</Label>
          </ParameterValue>
        </ParameterValues>
      </ValidValues>
    </ReportParameter>
